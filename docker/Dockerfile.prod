# Imagen de producción: PHP-FPM + Nginx (targets `app` y `nginx`).
# No usar este Dockerfile con `php artisan serve`.

FROM php:8.3-fpm-bookworm AS app

RUN apt-get update && apt-get install -y --no-install-recommends \
    git unzip curl gnupg ca-certificates \
    libzip-dev libpng-dev libjpeg62-turbo-dev libfreetype6-dev libwebp-dev \
    libonig-dev libicu-dev libfcgi-bin libpq-dev \
    && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc | gpg --dearmor -o /usr/share/keyrings/pgdg.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/pgdg.gpg] http://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends postgresql-client-16 \
    && docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp \
    && docker-php-ext-install pdo_pgsql zip gd bcmath pcntl exif intl opcache \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && rm -rf /var/lib/apt/lists/*

COPY docker/php/prod.ini /usr/local/etc/php/conf.d/app.ini
COPY docker/php/zz-www.conf /usr/local/etc/php-fpm.d/zz-prod.conf

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

ENV APP_ENV=production \
    APP_DEBUG=false \
    LOG_CHANNEL=stderr \
    COMPOSER_ALLOW_SUPERUSER=1

COPY . .

RUN composer install --no-dev --optimize-autoloader --no-interaction --prefer-dist --no-scripts \
    && composer dump-autoload --optimize --no-dev --no-interaction \
    && php artisan package:discover --ansi \
    && mkdir -p /opt/storage-defaults storage/app/public bootstrap/cache \
    && cp -a storage/app/public/. /opt/storage-defaults/ \
    && chown -R www-data:www-data storage bootstrap/cache \
    && rm -f /usr/bin/composer

COPY docker/php/ensure-storage.sh /usr/local/bin/ensure-storage.sh
COPY docker/php/ensure-app-key.sh /usr/local/bin/ensure-app-key.sh
COPY docker/php/entrypoint.prod.sh /usr/local/bin/entrypoint.prod.sh
COPY docker/php/queue-start.sh /usr/local/bin/queue-start.sh
COPY docker/php/scheduler-start.sh /usr/local/bin/scheduler-start.sh
RUN chmod +x /usr/local/bin/ensure-storage.sh /usr/local/bin/ensure-app-key.sh \
    /usr/local/bin/entrypoint.prod.sh /usr/local/bin/queue-start.sh \
    /usr/local/bin/scheduler-start.sh

EXPOSE 9000

HEALTHCHECK --interval=15s --timeout=5s --retries=10 --start-period=45s \
    CMD SCRIPT_NAME=/ping SCRIPT_FILENAME=/ping REQUEST_METHOD=GET cgi-fcgi -bind -connect 127.0.0.1:9000 || exit 1

ENTRYPOINT ["/usr/local/bin/entrypoint.prod.sh"]

FROM nginx:1.27-alpine AS nginx

COPY docker/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=app /var/www/html/public /var/www/html/public

EXPOSE 80

HEALTHCHECK --interval=15s --timeout=5s --retries=10 \
    CMD wget -qO- http://127.0.0.1/up >/dev/null || exit 1
