APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8090

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Docker Compose: dentro de los contenedores usar hosts de servicio (postgres, redis, mailhog).
# Desde el host: Postgres 127.0.0.1:5433, Redis 127.0.0.1:6381
# Mailpit (opcional, --profile mail): UI http://localhost:8025, SMTP host 127.0.0.1:1026
APP_PUBLISH_PORT=8090
DB_PUBLISH_PORT=5433
REDIS_PUBLISH_PORT=6381
MAILHOG_UI_PORT=8025
MAILHOG_SMTP_PORT=1026
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
RUN_MIGRATIONS=true
RUN_SEED=true
# uid/gid del usuario del host (id -u / id -g) para que vendor y storage no queden de root
WWWUSER=1000
WWWGROUP=1000

# Producción (docker-compose.prod.yml): nginx en APP_PUBLISH_PORT (default 80).
# Postgres y Redis no se publican al host. RUN_SEED=false. APP_DEBUG se fuerza a false.
# Obligatorio en internet:
#   DB_PASSWORD=<secreto>          # compose prod no arranca sin esto
#   REDIS_PASSWORD=<secreto>       # Redis con requirepass
#   MINIO_ROOT_PASSWORD=<secreto>  # MinIO (compose prod no arranca sin esto)
#   AWS_URL=https://tudominio.com/media/ventas-public
#   AWS_PUBLIC_ENDPOINT=https://tudominio.com/media
#   SESSION_SECURE_COOKIE=true     # compose prod lo fuerza
#   TRUSTED_PROXIES=private        # compose prod lo fuerza (redes Docker)
#   PLATFORM_ADMIN_PASSWORD=<secreto>  # obligatorio si RUN_SEED=true en prod
#   CENTRAL_DOMAINS=tudominio.com,www.tudominio.com,admin.tudominio.com
#   TENANT_BASE_DOMAIN=tudominio.com
#   PLATFORM_PATH=<prefijo-opaco>
#   PLATFORM_DOMAIN=admin.tudominio.com
#   MAIL_MAILER=smtp
# DNS wildcard *.tudominio.com. Confirmá que queue y scheduler estén Up.

# Backups SQL (tenants:backup a las 02:30). En prod la carpeta del host se monta
# en storage/app/backups. Para Google Drive, apuntá BACKUP_HOST_PATH a esa carpeta
# o sincronizá ./backups. 0 días = no borrar dumps viejos.
BACKUP_HOST_PATH=./backups
BACKUP_KEEP_DAYS=14
BACKUP_COMPRESS=true

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
# Base central de la plataforma (tenants, planes, pagos). Comercios: tenant_{slug}
DB_DATABASE=ventas_central
DB_USERNAME=ventas
DB_PASSWORD=ventas

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
# No uses FILESYSTEM_DISK=s3: logs, sesiones y backups se quedan en disco.
MEDIA_PUBLIC_DISK=minio
MEDIA_PRIVATE_DISK=filemanager
MEDIA_PAYMENT_DISK=minio_private
FILEMANAGER_DRIVER=s3
QUEUE_CONNECTION=redis
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Local HTTP: false. Producción: true (HTTPS).
SESSION_SECURE_COOKIE=false

# SaaS multi-tenant
CENTRAL_DOMAINS=localhost,127.0.0.1
TENANT_BASE_DOMAIN=localhost
# Panel staff: prefijo URL (cambiar en producción) y subdominio opcional exclusivo
PLATFORM_PATH=plataforma
# PLATFORM_DOMAIN=admin.localhost
# Proxies de confianza para X-Forwarded-*. Vacío = no confiar (artisan serve).
# Producción: private (compose prod lo fuerza). Nunca * en internet.
TRUSTED_PROXIES=
# Contraseña del staff al sembrar. Vacío en local → "plataforma".
# En production el seeder exige este valor.
PLATFORM_ADMIN_PASSWORD=
SAAS_BRAND="AranduTech Ventas"
SAAS_WHATSAPP=595981000000
SAAS_GRACE_DAYS=7
SAAS_READONLY_DAYS=3
SAAS_REMINDER_DAYS=3
SAAS_ADMIN_INVITE_HOURS=48
SIFEN_DRIVER=null
SIFEN_PARTNER_URL=
SIFEN_PARTNER_TOKEN=

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=redis
# Local: vacío. Producción: obligatorio (docker-compose.prod.yml no arranca sin esto).
REDIS_PASSWORD=
REDIS_PORT=6379

# Sin Mailpit: log. Bandeja local: smtp + `docker compose --profile mail up -d`
MAIL_MAILER=log
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_PUBLIC=ventas-public
MINIO_BUCKET_PRIVATE=ventas-private

AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=ventas-public
AWS_PRIVATE_BUCKET=ventas-private
AWS_ENDPOINT=http://minio:9000
AWS_URL=http://localhost:9000/ventas-public
AWS_PUBLIC_ENDPOINT=http://localhost:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

RECAPTCHA_SITE_KEY=YOUR_API_SITE_KEY
RECAPTCHA_SECRET_KEY=YOUR_API_SECRET_KEY

# Observabilidad (vacío / false = apagado)
# Sentry: errores y traces. Sin DSN no se envía nada.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
# Colas: true = el worker corre `horizon` en vez de `queue:work`
HORIZON_ENABLED=false
# Debug local (require-dev). En prod el Dockerfile usa --no-dev.
TELESCOPE_ENABLED=false
HEALTH_ENABLED=true
HEALTH_PATH=up
HEALTH_CHECK_REDIS=true
HEALTH_CHECK_MINIO=true
# Perfiles Docker locales (opcionales):
#   docker compose --profile mail up -d
#   docker compose --profile obs up -d
DOZZLE_PORT=9999
UPTIME_KUMA_PORT=3001
