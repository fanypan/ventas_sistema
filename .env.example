APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8090

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Docker Compose: dentro de los contenedores usar hosts de servicio (mysql, redis, mailhog).
# Desde el host: MySQL 127.0.0.1:3307, Redis 127.0.0.1:6381, Mailpit UI http://localhost:8025
# SMTP Mailpit desde el host: 127.0.0.1:1026 (dentro del contenedor: mailhog:1025)
APP_PUBLISH_PORT=8090
DB_PUBLISH_PORT=3307
REDIS_PUBLISH_PORT=6381
MAILHOG_UI_PORT=8025
MAILHOG_SMTP_PORT=1026
MYSQL_ROOT_PASSWORD=root
RUN_MIGRATIONS=true
RUN_SEED=true
# uid/gid del usuario del host (id -u / id -g) para que vendor y storage no queden de root
WWWUSER=1000
WWWGROUP=1000

# Producción (docker-compose.prod.yml): nginx en APP_PUBLISH_PORT (default 80).
# MySQL y Redis no se publican al host. RUN_SEED=false. APP_DEBUG se fuerza a false.

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=admin_lte3
DB_USERNAME=ventas
DB_PASSWORD=ventas

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=file
SESSION_LIFETIME=120

# SaaS multi-tenant
CENTRAL_DOMAINS=localhost,127.0.0.1
TENANT_BASE_DOMAIN=localhost
SAAS_BRAND="AranduTech Ventas"
SAAS_WHATSAPP=595981000000
SAAS_GRACE_DAYS=7
SAAS_READONLY_DAYS=3
SAAS_REMINDER_DAYS=3
SIFEN_DRIVER=null
SIFEN_PARTNER_URL=
SIFEN_PARTNER_TOKEN=

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

RECAPTCHA_SITE_KEY=YOUR_API_SITE_KEY
RECAPTCHA_SECRET_KEY=YOUR_API_SECRET_KEY
